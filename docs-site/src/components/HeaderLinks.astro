---
// Product links in the header: Support as a text link, then Open LicenseMeter as the primary pill.
---

<a class="header-link" href="https://www.licensemeter.com/support">Support</a>
<a class="header-cta" href="https://www.licensemeter.com">Open LicenseMeter</a>

<style>
	.header-link {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: color 150ms ease;
	}
	.header-link:hover {
		color: var(--sl-color-white);
	}
	/* Teal 700 under white text keeps 5.5:1 in both themes. */
	.header-cta {
		display: inline-flex;
		align-items: center;
		height: 2.25rem;
		padding-inline: 1rem;
		border-radius: 999px;
		background-color: var(--lm-teal-700);
		color: #fff;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 150ms ease;
	}
	.header-cta:hover {
		background-color: var(--lm-teal-800);
		color: #fff;
	}
</style>
