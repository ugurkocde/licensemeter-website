---
// Page title with the frontmatter description as a muted subtitle directly under it, as GitBook does.
// The id must stay "_top": Starlight's skip link and table of contents point at it.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="page-description">{description}</p>}

<style>
	h1 {
		margin-top: 0.5rem;
		font-size: clamp(1.875rem, 1.5rem + 1.4vw, 2.5rem);
		line-height: 1.15;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: pretty;
	}
	.page-description {
		margin-top: 0.75rem;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: var(--sl-color-gray-3);
		text-wrap: pretty;
	}
	@media (max-width: 49.99rem) {
		.page-description {
			font-size: 1.0625rem;
		}
	}
</style>
