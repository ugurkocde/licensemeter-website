# Run node scripts/setup-docker.mjs to create .env.docker with unique secrets.
# Compose must be invoked with --env-file .env.docker.
# Passwords below must be URL-safe (the generator uses hexadecimal).
POSTGRES_PASSWORD=__GENERATE_SECRET__
POSTGRES_APP_PASSWORD=__GENERATE_SECRET__
AUTH_SECRET=__GENERATE_SECRET__
DATA_ENCRYPTION_KEY=__GENERATE_SECRET__
CRON_SECRET=__GENERATE_SECRET__

APP_BASE_URL=http://localhost:3000
HTTP_PORT=3000
# The initial local instance is sample-only. Set false before exposing it.
DEMO_MODE=true

# For real tenants, register your own apps using scripts/setup-entra.ps1.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
CONNECTOR_CLIENT_ID=
CONNECTOR_CLIENT_SECRET=

# Optional email features. Support messages go only to your configured mailbox.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_TO_EMAIL=
SUPPORT_FROM_EMAIL=
SUPPORT_TURNSTILE_SITE_KEY=
SUPPORT_TURNSTILE_SECRET_KEY=

# Disabled on self-hosted instances unless you set your own Crisp website ID.
CRISP_WEBSITE_ID=
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# Paid plans belong to the hosted service. Self-hosted instances leave
# BILLING_ENABLED unset and every workspace gets every feature; Compose does not
# pass it to the containers. The hosted service sets it to true, and only after
# running scripts/db-create-entitlements.sql, because with the flag on every
# request reads the entitlements table.
# BILLING_ENABLED=
