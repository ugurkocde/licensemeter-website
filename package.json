{
  "name": "licensemeter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "ci": "npm run format:check && npm run check && npm run test && npm run build",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,yml,yaml}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,yml,yaml}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config docker/drizzle.config.ts",
    "test:docker": "node --test docker/*.test.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@react-pdf/renderer": "^4.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "^15.5.24",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "svix": "^2.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.0",
    "@emnapi/wasi-threads": "^2.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@napi-rs/wasm-runtime": "^1.2.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tybys/wasm-util": "^0.10.2",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.8"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "sharp": "$sharp"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT"
}
