# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Production: a Postgres connection string (use an EU region, e.g. Neon eu-central-1).
# Leave unset for local development: an embedded PGlite database is used instead.
# DATABASE_URL="postgres://user:password@host:5432/licensemeter"

# --- Authentication ---------------------------------------------------------
# Everyone signs in with Microsoft Entra ID (work and school accounts).
# AUTH_SECRET signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=""
# Generate a separate key for connector credential encryption in production.
DATA_ENCRYPTION_KEY=""

# --- Sign-in app registration (delegated, multi-tenant) ----------------------
# Created by scripts/setup-entra.ps1. Only needs openid/profile/email.
# Optional while you only use demo mode.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# --- Connector app registration (application permissions, read-only) ---------
# Created by scripts/setup-entra.ps1. Granted per customer tenant via admin consent.
# Permissions: User.Read.All, AuditLog.Read.All, Reports.Read.All,
#              LicenseAssignment.Read.All, ReportSettings.Read.All
CONNECTOR_CLIENT_ID=""
CONNECTOR_CLIENT_SECRET=""

# --- Operations ---------------------------------------------------------------
# Protects /api/cron/*. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Optional: Teams/Slack incoming webhook for sync-failure alerts.
# ALERT_WEBHOOK_URL=""
# Optional: email recipient for the same alerts (needs RESEND_API_KEY + EMAIL_FROM).
# ALERT_EMAIL=""

# The bring-your-own app registration option on the Microsoft connector page
# is on by default. Set to "false" to offer the managed one-click path only.
# MS_BYO_ENABLED="true"

# Optional: enables the weekly digest email (both required together).
# RESEND_API_KEY=""
# EMAIL_FROM="LicenseMeter <digest@your-domain.example>"
# Optional: signing secret of a Resend webhook pointed at /api/webhooks/resend.
# Enables delivery status and stops mail to addresses that permanently fail.
# RESEND_WEBHOOK_SECRET=""

# "true" enables the demo workspace on the landing page (no Entra setup needed).
DEMO_MODE="true"

# Optional. Database role withTenant() switches to so tenant RLS is enforced on
# wrapped queries. Run scripts/db-tenant-rls.sql and set this to
# "licensemeter_tenant" to turn database-level tenant isolation on.
# TENANT_DB_ROLE="licensemeter_tenant"

# Public base URL of the deployment; used for the admin-consent redirect URI.
# Defaults to http://localhost:3000 in development.
# APP_BASE_URL="https://app.licensemeter.example"

# Support uses RESEND_API_KEY + EMAIL_FROM above. Optional sender override
# and extra Turnstile verification (set both keys for this domain).
SUPPORT_FROM_EMAIL=""
SUPPORT_TO_EMAIL=""
SUPPORT_TURNSTILE_SITE_KEY=""
SUPPORT_TURNSTILE_SECRET_KEY=""

# Optional self-host behavior. Docker sets this automatically.
# SELF_HOSTED="true"
# CRISP_WEBSITE_ID=""

# Paid hosted plans. Leave unset when you self-host: every workspace gets every
# feature and the billing tables are never read. Only the hosted service sets
# "true". Run scripts/db-create-entitlements.sql BEFORE turning it on, because
# with the flag on every request reads the entitlements table.
# BILLING_ENABLED="true"

# Polar (card checkout, merchant of record). Hosted service only. Product ids
# are the four recurring products created in the Polar dashboard.
# POLAR_ACCESS_TOKEN=""
# POLAR_WEBHOOK_SECRET=""
# POLAR_SERVER="sandbox"
# POLAR_PRODUCT_PRO_MONTH=""
# POLAR_PRODUCT_PRO_YEAR=""
# POLAR_PRODUCT_MSP_MONTH=""
# POLAR_PRODUCT_MSP_YEAR=""

# Microsoft Marketplace transactable SaaS offer. Hosted service only. The Entra
# app registered in Partner Center for the SaaS Fulfillment API, the public
# listing URL, and the plan ids as defined in the offer (default pro and msp).
# MARKETPLACE_TENANT_ID=""
# MARKETPLACE_CLIENT_ID=""
# MARKETPLACE_CLIENT_SECRET=""
# MARKETPLACE_OFFER_URL=""
# MARKETPLACE_PLAN_PRO="pro"
# MARKETPLACE_PLAN_MSP="msp"
